{
  "name": "smart-library",
  "version": "1.0.0",
  "description": "智能图书管理系统 - B/S Web Application",
  "private": true,
  "scripts": {
    "dev": "start.bat",
    "dev:server": "cd server && npm run dev",
    "dev:web": "cd web && npm run dev",
    "db:generate": "tsx scripts/generate-data-v2.ts",
    "db:clear": "tsx scripts/clear-database.ts",
    "db:clear:all": "tsx scripts/clear-database.ts --all",
    "replit:build": "cd web && npm install && npm run build",
    "replit:start": "npm run replit:build && NODE_ENV=production tsx server/src/server.ts"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.8",
    "@types/node": "^20.19.27",
    "better-sqlite3": "^9.6.0",
    "commander": "^14.0.3",
    "tsx": "^4.20.6",
    "typescript": "^5.3.3"
  },
  "volta": {
    "node": "20.20.2",
    "npm": "10.9.7"
  }
}
