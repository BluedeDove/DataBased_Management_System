run = "npm run replit:start"
modules = ["nodejs-20"]

[nix]
channel = "stable-24_05"

[deployment]
run = ["sh", "-c", "npm run replit:start"]
deploymentTarget = "cloudrun"

[userenv]

[userenv.shared]
NODE_ENV = "production"
JWT_SECRET = "b1d6f2f7cce54410a40a2f1a6e9b7ab8b730a5c4f4a8a4c7f1d7c8c4c3a1c3aef7d855d36c8425f2b7f9e0b2f9f1ce7fd8ec13ef349f2f30f10d5d068d4a7d2e"

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run replit:serve"
waitForPort = 5000

[[ports]]
localPort = 5000
externalPort = 80
