# Server Configuration
PORT=3001
NODE_ENV=development

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Database
DATABASE_PATH=./data/library.db

# CORS (comma-separated origins)
# Local loopback origins like localhost / 127.0.0.1 are auto-compatible.
# Add your remote frontend domains here if you deploy across different origins.
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,https://your-app.replit.app,https://*.replit.dev,https://*.repl.co

# AI Configuration (Optional)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
CHAT_MODEL=Pro/MiniMaxAI/MiniMax-M2.5
